const out = {}; const TRY = async (name, fn) => { try { await fn(); out[name] = 'ok'; } catch (e) { out[name] = 'ERR ' + (e && e.message); } };
const n = trackPoints.length, route = (i) => trackPoints[((i % n) + n) % n], angAt = (i) => { const p = route(i), q = route(i + 6); return Math.atan2(q.x - p.x, q.y - p.y); };
const put = (i, sp) => { const p = route(i); car.x = p.x; car.z = p.y; car.angle = angAt(i); car.vx = Math.sin(car.angle)*(sp || 0); car.vz = Math.cos(car.angle)*(sp || 0); car.speed = sp || 0; carGroup.position.set(car.x, Y(car.x, car.z), car.z); carGroup.rotation.set(0, car.angle, 0); };
const nearIdx = (x, z) => { let b = 0, bd = 1e18; for (let i = 0; i < n; i++) { const d = (trackPoints[i].x - x)**2 + (trackPoints[i].y - z)**2; if (d < bd) { bd = d; b = i; } } return b; };
const hold = (k) => { for (let i = 0; i < k; i++) { const vx = car.vx, vz = car.vz, x = car.x, z = car.z; step(1); car.x = x; car.z = z; car.vx = vx; car.vz = vz; } };   // (time passes, the car stays)
const view = async (name, tx, ty, tz, cx, cy, cz) => { HUMANS.forEach(q => { q.far = Math.hypot(q.x - car.x, q.z - car.z) >= 240; if (q.view.kind === 'rig') humanSync(q); }); nearVisT = 0; nearVisUpdate(0.01);
  camera.position.set(cx, cy, cz); camera.lookAt(tx, ty, tz); camera.fov = 55; camera.updateProjectionMatrix(); camera.updateMatrixWorld(); skyDome.position.copy(camera.position);
  dirLight.position.set(tx + SUN.x, ty + SUN.y, tz + SUN.z); dirLight.target.position.set(tx, ty, tz); dirLight.target.updateMatrixWorld(); RR(scene, camera); await __save('s3_lh_' + name + '.png', renderer.domElement.toDataURL('image/png')); };
const around = async (name, x, z, dist, up, ang, ly) => { const gy = Y(x, z); await view(name, x, gy + (ly || 1), z, x + Math.sin(ang)*dist, Math.max(gy + up, Y(x + Math.sin(ang)*dist, z + Math.cos(ang)*dist) + 1.5), z + Math.cos(ang)*dist); };
const clearLine = (x0, z0, x1, z1) => { for (let k = 1; k < 8; k++) { const t = k/8, x = x0 + (x1 - x0)*t, z = z0 + (z1 - z0)*t; if (treeNear(x, z, 2.2)) return false; let hit = false; staticNear(x, z, 3, B => { if (!hit && boxPush(B, x, z, 0.8)) hit = true; }); if (hit) return false; } return true; };
const aroundClear = async (name, x, z, dist, up, ly, pref) => { let best = pref || 0.7; for (let k = 0; k < 24; k++) { const a = (pref || 0.7) + k*0.2618*(k % 2 ? 1 : -1)*Math.ceil(k/2)/Math.max(1, k); const cx = x + Math.sin(a)*dist, cz = z + Math.cos(a)*dist; if (clearLine(x, z, cx, cz) && !treeNear(cx, cz, 3)) { best = a; break; } } await around(name, x, z, dist, up, best, ly); };
